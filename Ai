
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ChanhNgot - Gewon Music</title>

<style>
#cn-toggle,#cn-widget *{box-sizing:border-box}
#cn-toggle{
  position:fixed;right:22px;bottom:22px;z-index:99999;
  border:0;border-radius:50px;padding:15px 21px;
  background:#b8ed55;color:#18351c;font-weight:700;
  font-size:15px;cursor:pointer;
  box-shadow:0 5px 20px #0002
}
#cn-widget{
  display:none;position:fixed;right:22px;bottom:85px;
  width:min(370px,calc(100vw - 28px));height:520px;
  background:#fff;z-index:99999;border-radius:20px;
  overflow:hidden;border:1px solid #e5e7eb;
  box-shadow:0 10px 40px #0003;
  font-family:Arial,sans-serif;color:#202820
}
#cn-header{
  padding:16px;background:#b8ed55;color:#18351c;
  display:flex;align-items:center;justify-content:space-between
}
#cn-header strong{font-size:16px}
#cn-header small{display:block;font-weight:400;margin-top:4px}
#cn-header button{
  border:0;background:transparent;font-size:22px;
  cursor:pointer;color:#18351c
}
#cn-tools{
  display:flex;gap:7px;padding:10px;overflow-x:auto;
  border-bottom:1px solid #eee;background:#fff
}
#cn-tools button{
  white-space:nowrap;border:1px solid #dce7d4;
  background:#f7faef;border-radius:20px;padding:7px 10px;
  font-size:12px;cursor:pointer;color:#29442a
}
#cn-messages{
  height:330px;overflow-y:auto;padding:13px;
  background:#f8faf6
}
.cn-msg{
  padding:10px 12px;margin:8px 0;border-radius:13px;
  max-width:90%;font-size:13px;line-height:1.55;
  white-space:pre-wrap;overflow-wrap:anywhere
}
.cn-bot{background:white;border:1px solid #e6e9e2}
.cn-user{background:#e2f5c6;margin-left:auto}
#cn-form{
  display:flex;gap:7px;padding:11px;
  border-top:1px solid #eee;background:white
}
#cn-input{
  flex:1;min-width:0;border:1px solid #d9dfd5;
  border-radius:22px;padding:12px;font-size:13px;outline:none
}
#cn-input:focus{border-color:#92c83e}
#cn-send{
  border:0;border-radius:22px;padding:0 15px;
  background:#b8ed55;font-weight:bold;cursor:pointer
}
#cn-note{
  font-size:10px;color:#777;text-align:center;
  padding:0 8px 7px;background:white
}
@media(max-width:480px){
  #cn-widget{right:10px;bottom:80px;height: min(520px,75vh)}
  #cn-messages{height:calc(min(520px,75vh) - 155px)}
  #cn-toggle{right:14px;bottom:14px}
}
</style>
</head>

<body>

<!-- CHATBOT CHANHNGOT -->
<button id="cn-toggle" type="button">🍋 Chat với ChanhNgot</button>

<div id="cn-widget" role="dialog" aria-label="Chatbot Gewon Music">
  <div id="cn-header">
    <div>
      <strong>🍋 ChanhNgot</strong>
      <small>Trợ lý âm nhạc · Gewon Music</small>
    </div>
    <button id="cn-close" type="button" aria-label="Đóng">×</button>
  </div>

  <div id="cn-tools">
    <button type="button" data-question="Tư vấn piano cho người mới học">🎹 Piano</button>
    <button type="button" data-question="Tư vấn chọn guitar">🎸 Guitar</button>
    <button type="button" data-question="Tư vấn organ">🎼 Organ</button>
    <button type="button" data-question="Tư vấn trống">🥁 Trống</button>
    <button type="button" data-question="Tư vấn phụ kiện nhạc cụ">🎧 Phụ kiện</button>
    <button type="button" data-question="Giá đàn hiện tại là bao nhiêu?">💰 Giá đàn</button>
  </div>

  <div id="cn-messages" aria-live="polite">
    <div class="cn-msg cn-bot">Xin chào! Mình là ChanhNgot 🍋 của Gewon Music.

Mình có thể giúp bạn:
• Tư vấn piano, guitar, organ, ukulele, violin, trống.
• Tìm hiểu giá và thông số sản phẩm đã có dữ liệu.
• Giải đáp nhạc lý, học đàn, phụ kiện và bảo quản.
• So sánh nhạc cụ theo nhu cầu và ngân sách.

Hôm nay bạn đang quan tâm đến điều gì?</div>
  </div>

  <form id="cn-form">
    <input id="cn-input" placeholder="Hỏi ChanhNgot về âm nhạc..." autocomplete="off" required>
    <button id="cn-send" type="submit">Gửi</button>
  </form>
  <div id="cn-note">Giá và tồn kho cần dữ liệu được cửa hàng xác nhận.</div>
</div>

<script>
(() => {
"use strict";

/* =========================================
   1. DỮ LIỆU SẢN PHẨM CỦA GEWON MUSIC
   Thay ví dụ bên dưới bằng thông tin thật.
   Không nhập giá hoặc tồn kho chưa xác minh.
========================================= */
const products = [
  // Ví dụ cấu trúc:
  // {
  //   name: "Yamaha P-145",
  //   aliases: ["p145", "yamaha p 145"],
  //   category: "piano",
  //   price: 0,
  //   stock: "Chưa cập nhật",
  //   description: "Nhập thông số đã xác minh tại đây"
  // }
];

/* =========================================
   2. GIAO DIỆN CHAT
========================================= */
const toggle = document.getElementById("cn-toggle");
const widget = document.getElementById("cn-widget");
const closeBtn = document.getElementById("cn-close");
const form = document.getElementById("cn-form");
const input = document.getElementById("cn-input");
const messages = document.getElementById("cn-messages");

toggle.addEventListener("click", () => {
  widget.style.display =
    widget.style.display === "block" ? "none" : "block";
  if (widget.style.display === "block") input.focus();
});

closeBtn.addEventListener("click", () => {
  widget.style.display = "none";
});

function normalize(text) {
  return text.toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/đ/g, "d")
    .replace(/[^\p{L}\p{N}\s.-]/gu, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function addMessage(text, type) {
  const el = document.createElement("div");
  el.className = "cn-msg " + type;
  el.textContent = text;
  messages.appendChild(el);
  messages.scrollTop = messages.scrollHeight;
}

/* =========================================
   3. TRA CỨU SẢN PHẨM VÀ GIÁ
========================================= */
function findProduct(originalQuestion) {
  const q = normalize(originalQuestion);

  return products.find(product => {
    const names = [product.name, ...(product.aliases || [])];
    return names.some(name => {
      const normalizedName = normalize(name);
      return normalizedName.length > 1 && q.includes(normalizedName);
    });
  });
}

function productReply(product) {
  let result = "🎵 " + product.name + "\n";

  if (Number.isFinite(product.price) && product.price > 0) {
    result += "Giá đã nhập: " +
      product.price.toLocaleString("vi-VN") + " VNĐ\n";
  } else {
    result += "Giá: Chưa có giá được xác minh.\n";
  }

  result += "Tình trạng: " +
    (product.stock || "Chưa cập nhật") + "\n";

  if (product.description) {
    result += "Thông tin: " + product.description + "\n";
  }

  result += "\nGiá và tình trạng hàng có thể cần được cửa hàng xác nhận lại.";
  return result;
}

/* =========================================
   4. KHO TRI THỨC ÂM NHẠC
========================================= */
function getReply(question) {
  const q = normalize(question);
  const has = (...words) => words.some(word => q.includes(word));

  // Sản phẩm cụ thể phải được tra trước.
  const product = findProduct(question);
  if (product) return productReply(product);

  // Chào hỏi
  if (has("xin chao", "hello", "hi ban", "chao shop")) {
    return "Xin chào! 🍋 Mình là ChanhNgot của Gewon Music.\nBạn cần tư vấn chọn đàn, tìm hiểu nhạc lý, học nhạc hay tra cứu sản phẩm?";
  }

  if (has("cam on", "thanks")) {
    return "Rất vui được hỗ trợ bạn! 🍋 Bạn cứ hỏi mình thêm về nhạc cụ và âm nhạc nhé.";
  }

  // Giá, khuyến mãi, tồn kho
  if (has("gia", "bao nhieu tien", "bao nhieu", "khuyen mai",
          "giam gia", "tra gop", "con hang", "ton kho")) {
    return "💰 Mình chỉ có thể báo giá khi có dữ liệu sản phẩm đã xác minh.\nHiện chưa có bảng giá hoặc tồn kho được kết nối trong chatbot này. Bạn gửi tên hoặc mã model chính xác; hãy xác nhận giá hiện hành với Gewon Music trước khi mua nhé.";
  }

  // Piano
  if (has("piano co", "piano acoustic")) {
    return "🎹 PIANO CƠ\n• Tạo âm thanh bằng búa gõ vào dây đàn.\n• Có cảm giác phím và độ biểu cảm đặc trưng.\n• Cần không gian và bảo dưỡng, lên dây định kỳ.\n• Phù hợp người muốn chơi piano truyền thống.\nBạn nên thử đàn trực tiếp và kiểm tra tình trạng máy trước khi mua.";
  }

  if (has("piano dien", "digital piano", "piano dien tu")) {
    return "🎹 PIANO ĐIỆN\n• Thường gọn hơn piano cơ.\n• Có thể có tai nghe, điều chỉnh âm lượng và nhiều âm sắc.\n• Nên kiểm tra lực phím, số phím, pedal, loa và kết nối.\n• Một số model có 88 phím nhưng cần xác minh từng model.\nBạn mua để học tại nhà, biểu diễn hay luyện thi?";
  }

  if (has("piano", "dan piano")) {
    return "🎹 Khi chọn piano, hãy cân nhắc:\n1. Piano cơ hay piano điện.\n2. Cảm giác phím và âm thanh.\n3. Kích thước, không gian đặt đàn.\n4. Tính năng, bảo hành và ngân sách.\nBạn mới học hay đã chơi piano? Mình sẽ tư vấn theo nhu cầu.";
  }

  // Guitar
  if (has("guitar classic", "guitar co dien", "day nylon")) {
    return "🎸 GUITAR CLASSIC\nThường dùng dây nylon, âm thanh ấm và lực bấm tương đối dễ chịu. Phù hợp nhạc cổ điển, fingerstyle và người thích âm thanh mềm. Hãy kiểm tra độ cao dây, cần đàn và kích thước thân đàn.";
  }

  if (has("guitar acoustic", "dem hat", "day sat")) {
    return "🎸 GUITAR ACOUSTIC\nThường dùng dây thép, âm thanh sáng và vang, phù hợp đệm hát, pop và folk. Người mới nên chọn đàn dễ bấm, cần đàn thoải mái và kích thước phù hợp cơ thể.";
  }

  if (has("guitar dien", "electric guitar", "rock")) {
    return "🎸 GUITAR ĐIỆN\nCần xem pickup, cần đàn, số phím, cầu đàn và thể loại nhạc. Để phát âm thanh, bạn thường cần ampli hoặc thiết bị mô phỏng ampli. Phụ kiện có thể gồm dây đàn, pick, dây jack và dây đeo.";
  }

  if (has("guitar", "dan guitar")) {
    return "🎸 Có ba nhóm guitar phổ biến:\n• Classic: dây nylon, âm thanh ấm.\n• Acoustic: thường dùng dây thép, hợp đệm hát.\n• Guitar điện: thường dùng cùng ampli.\nBạn muốn chơi nhạc gì và ngân sách dự kiến bao nhiêu?";
  }

  // Organ / keyboard
  if (has("organ", "keyboard", "dan phim dien")) {
    return "🎹 ORGAN / KEYBOARD\nThường có nhiều âm sắc, điệu đệm tự động và tính năng hỗ trợ học nhạc. Khi chọn đàn, hãy kiểm tra số phím, loa, lực phím, điệu đệm, cổng kết nối và mục đích sử dụng. Keyboard không phải lúc nào cũng có cảm giác phím như piano.";
  }

  // Ukulele
  if (has("ukulele")) {
    return "🎵 UKULELE\nLà nhạc cụ nhỏ gọn, thường có 4 dây, thích hợp đệm hát và mang đi du lịch. Kích thước phổ biến gồm soprano, concert, tenor và baritone. Khi chọn đàn, hãy xem kích thước, độ cao dây, âm thanh và khả năng giữ dây đúng cao độ.";
  }

  // Violin / nhạc cụ dây kéo
  if (has("violin", "viola", "cello", "dan keo")) {
    return "🎻 NHẠC CỤ DÂY KÉO\nCần chọn kích thước phù hợp, kiểm tra dây, vĩ, ngựa đàn và khả năng lên dây. Người mới học nên nhờ giáo viên hoặc người có kinh nghiệm kiểm tra đàn trước khi mua.";
  }

  // Trống
  if (has("trong dien", "trong dien tu")) {
    return "🥁 TRỐNG ĐIỆN\nƯu điểm thường là chỉnh âm lượng, dùng tai nghe và luyện tập trong nhà. Nên kiểm tra module âm thanh, pad, pedal, khung, độ nhạy và cổng kết nối.";
  }

  if (has("trong co", "bo trong", "acoustic drum")) {
    return "🥁 TRỐNG CƠ\nTạo âm thanh tự nhiên nhưng cần không gian và kiểm soát tiếng ồn. Khi chọn bộ trống, hãy cân nhắc kích thước, số trống, cymbal, phần cứng và mục đích luyện tập hay biểu diễn.";
  }

  if (has("trong", "drum")) {
    return "🥁 Bạn đang tìm trống cơ hay trống điện? Mình có thể tư vấn cách chọn, không gian lắp đặt, phụ kiện và những thông số cần kiểm tra.";
  }

  // Nhạc cụ khác
  if (has("violin", "saxophone", "flute", "sao truc",
          "ken", "harmonica", "kalimba", "melodica")) {
    return "🎶 Với nhạc cụ này, hãy cân nhắc trình độ, kích thước, chất liệu, khả năng lên dây, phụ kiện đi kèm và mục đích sử dụng. Bạn cho mình biết model hoặc nhu cầu cụ thể để được tư vấn sát hơn nhé.";
  }

  // Thiết bị và phụ kiện
  if (has("micro", "loa", "tai nghe", "sound card",
          "audio interface", "mixer", "amply", "ampli")) {
    return "🎧 THIẾT BỊ ÂM THANH\nKhi chọn thiết bị, hãy kiểm tra mục đích sử dụng, cổng kết nối, độ tương thích và thông số kỹ thuật. Thu âm tại nhà, biểu diễn và nghe nhạc có những nhu cầu khác nhau. Bạn đang dùng thiết bị nào?";
  }

  if (has("capo", "pick", "mieng ga", "day dan",
          "pedal", "chan dan", "gia nhac", "bao dan",
          "day jack", "phu kien")) {
    return "🎼 PHỤ KIỆN NHẠC CỤ\n• Chọn dây đàn đúng loại nhạc cụ và kích cỡ.\n• Kiểm tra tính tương thích của pedal và cổng kết nối.\n• Chọn bao đàn theo kích thước nhạc cụ.\n• Kiểm tra jack cắm, chân đàn và giá nhạc trước khi mua.\nBạn cần phụ kiện cho model nào?";
  }

  // Nhạc lý
  if (has("not nhac", "doc not", "khuong nhac", "khoa sol", "khoa fa")) {
    return "🎼 NHẠC LÝ CƠ BẢN\nKhuông nhạc tiêu chuẩn gồm 5 dòng và 4 khe. Khóa Sol thường dùng cho âm vực cao; khóa Fa thường dùng cho âm vực thấp. Tên và cao độ nốt phụ thuộc khóa nhạc và vị trí nốt trên khuông.";
  }

  if (has("hop am", "chord")) {
    return "🎼 HỢP ÂM\nHợp âm là nhóm nốt vang lên cùng lúc. Hợp âm trưởng và thứ tạo màu sắc khác nhau. Người mới học guitar hoặc piano có thể bắt đầu với hợp âm cơ bản, luyện từng nốt rõ ràng và tập chuyển hợp âm chậm, đều.";
  }

  if (has("gam truong", "gam thu", "scale", "gam nhac")) {
    return "🎼 GAM NHẠC\nGam là tập hợp các nốt được sắp xếp theo cao độ. Gam trưởng và gam thứ có cấu trúc khác nhau. Bạn có thể luyện từng gam chậm, đúng nhịp và tăng tốc dần khi chơi chính xác.";
  }

  if (has("nhip", "tempo", "bpm", "metronome", "may danh nhip")) {
    return "⏱️ NHỊP VÀ TEMPO\nTempo là tốc độ âm nhạc, thường biểu thị bằng BPM (số nhịp mỗi phút). Máy đếm nhịp giúp giữ tốc độ ổn định. Hãy bắt đầu chậm và tăng tốc khi đã chơi chắc.";
  }

  if (has("nhac ly", "ly thuyet am nhac", "hoa am",
          "sang tac", "phoi khi")) {
    return "🎼 Mình có thể giải thích nhạc lý, cao độ, trường độ, nhịp, gam, hợp âm, hòa âm và sáng tác theo từng bước. Bạn muốn tìm hiểu khái niệm nào? Mình có thể đưa ví dụ dễ hiểu.";
  }

  // Học nhạc
  if (has("moi hoc", "hoc dan", "tu hoc",
          "bat dau hoc", "luyen tap", "tap dan")) {
    return "🎓 LỘ TRÌNH HỌC NHẠC\n1. Chọn nhạc cụ phù hợp sở thích.\n2. Học tư thế và kỹ thuật cơ bản.\n3. Luyện nốt, hợp âm hoặc tiết tấu.\n4. Tập chậm với máy đếm nhịp.\n5. Luyện đều đặn và tăng độ khó từ từ.\nBạn muốn học nhạc cụ nào và đang ở trình độ nào?";
  }

  // Bảo quản và lỗi nhạc cụ
  if (has("bao quan", "ve sinh dan", "len day",
          "day bi dut", "phim bi liet", "dan bi re",
          "dan khong ra tieng")) {
    return "🛠️ BẢO QUẢN NHẠC CỤ\nGiữ nhạc cụ ở nơi khô thoáng, tránh nắng trực tiếp và thay đổi nhiệt độ, độ ẩm đột ngột. Khi có lỗi, cách xử lý phụ thuộc loại đàn và model. Bạn mô tả dấu hiệu hoặc gửi tên model để mình hướng dẫn an toàn hơn.";
  }

  // Chính sách / đơn hàng
  if (has("bao hanh", "doi tra", "sua dan",
          "don hang", "ma don", "van chuyen")) {
    return "🧾 Chính sách bảo hành, đổi trả, giao hàng và trạng thái đơn cần được kiểm tra theo quy định hiện hành của Gewon Music. Chatbot này chưa kết nối hệ thống đơn hàng hoặc chính sách cửa hàng, nên mình không thể xác nhận thay nhân viên.";
  }

  // Hỏi tư vấn chung về mua đàn
  if (has("nen mua dan nao", "chon dan", "tu van mua",
          "ngan sach", "so sanh dan")) {
    return "🛍️ Để chọn nhạc cụ phù hợp, hãy cho mình biết:\n• Bạn muốn học hoặc chơi nhạc cụ nào?\n• Trình độ hiện tại?\n• Ngân sách dự kiến?\n• Dùng tại nhà, đi học hay biểu diễn?\nMình sẽ giúp bạn so sánh những tiêu chí quan trọng.";
  }

  // Ngoài phạm vi
  const musicTopics = [
    "nhac", "am nhac", "dan", "piano", "guitar",
    "organ", "ukulele", "trong", "violin", "micro",
    "loa", "hop am", "not nhac", "nhac ly", "nhac cu",
    "phu kien", "thu am", "bieu dien", "hoc dan",
    "melody", "gewon", "chanhngot", "ampli"
  ];

  if (!musicTopics.some(topic => q.includes(topic))) {
    return "🍋 Xin lỗi bạn nhé! Mình là ChanhNgot của Gewon Music, chuyên hỗ trợ âm nhạc, nhạc cụ, phụ kiện và thông tin sản phẩm. Bạn muốn tìm hiểu về đàn piano, guitar hay nhạc cụ nào?";
  }

  // Câu hỏi âm nhạc chưa có câu trả lời cụ thể
  return "🍋 Mình hiểu bạn đang hỏi về âm nhạc, nhưng chưa có đủ thông tin để trả lời chính xác. Bạn hãy cung cấp thêm tên nhạc cụ, model hoặc chi tiết câu hỏi nhé. Để giải đáp linh hoạt các câu hỏi mới, cần kết nối thêm AI.";
}

/* =========================================
   5. GỬI CÂU HỎI VÀ NÚT GỢI Ý
========================================= */
function ask(question) {
  if (!question.trim()) return;
  addMessage(question, "cn-user");
  const answer = getReply(question);
  addMessage(answer, "cn-bot");
}

form.addEventListener("submit", event => {
  event.preventDefault();
  const question = input.value.trim();
  input.value = "";
  ask(question);
  input.focus();
});

document.querySelectorAll("#cn-tools button").forEach(button => {
  button.addEventListener("click", () => {
    ask(button.dataset.question);
  });
});

})();
</script>
