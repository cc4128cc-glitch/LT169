
<!-- CHANHNGOT CHATBOT - DÁN TRƯỚC THẺ </body> -->

<style>
#cn-toggle {
  position: fixed; right: 22px; bottom: 22px; z-index: 99999;
  border: 0; border-radius: 50px; padding: 14px 20px;
  background: #b8ed55; color: #18351c; font-weight: bold;
  cursor: pointer; box-shadow: 0 4px 18px #0003;
}
#cn-box {
  display: none; position: fixed; right: 22px; bottom: 85px;
  width: min(350px, calc(100vw - 30px)); height: 470px;
  z-index: 99999; background: white; border-radius: 18px;
  overflow: hidden; box-shadow: 0 8px 35px #0003;
  font: 14px Arial, sans-serif; border: 1px solid #e5e7eb;
}
#cn-head {
  background: #b8ed55; padding: 16px; color: #18351c;
  font-weight: bold; display: flex; justify-content: space-between;
}
#cn-head button { border: 0; background: transparent; cursor: pointer; }
#cn-messages {
  height: 335px; overflow-y: auto; padding: 14px;
  background: #f8faf6;
}
.cn-msg {
  padding: 10px 12px; margin: 8px 0; border-radius: 12px;
  max-width: 88%; white-space: pre-wrap; line-height: 1.45;
}
.cn-bot { background: white; border: 1px solid #e5e7eb; color: #222; }
.cn-user { background: #dff6b5; margin-left: auto; color: #18351c; }
#cn-form { display: flex; padding: 10px; gap: 7px; border-top: 1px solid #eee; }
#cn-input {
  flex: 1; min-width: 0; padding: 11px; border: 1px solid #ddd;
  border-radius: 20px; outline-color: #91c83e;
}
#cn-form button {
  border: 0; border-radius: 20px; padding: 0 14px;
  background: #b8ed55; cursor: pointer; font-weight: bold;
}
</style>

<button id="cn-toggle" type="button">🍋 Chat với ChanhNgot</button>

<div id="cn-box">
  <div id="cn-head">
    <span>🍋 ChanhNgot | Gewon Music</span>
    <button id="cn-close" type="button">✕</button>
  </div>
  <div id="cn-messages">
    <div class="cn-msg cn-bot">
      Xin chào! Mình là ChanhNgot 🍋
      Mình có thể tư vấn nhạc cụ, cách chọn đàn và phụ kiện cho bạn.
      Bạn đang quan tâm đến sản phẩm nào?
    </div>
  </div>
  <form id="cn-form">
    <input id="cn-input" placeholder="Nhập câu hỏi..." autocomplete="off" required>
    <button type="submit">Gửi</button>
  </form>
</div>

<script>
(() => {
  const toggle = document.getElementById("cn-toggle");
  const box = document.getElementById("cn-box");
  const close = document.getElementById("cn-close");
  const form = document.getElementById("cn-form");
  const input = document.getElementById("cn-input");
  const messages = document.getElementById("cn-messages");

  toggle.onclick = () => {
    box.style.display = box.style.display === "block" ? "none" : "block";
  };
  close.onclick = () => box.style.display = "none";

  function addMessage(text, type) {
    const div = document.createElement("div");
    div.className = "cn-msg " + type;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function reply(question) {
    const q = question.toLowerCase();

    const musicWords = [
      "đàn", "piano", "guitar", "organ", "ukulele", "trống",
      "nhạc", "âm thanh", "micro", "loa", "tai nghe", "dây đàn",
      "pick", "phím", "pedal", "nhạc cụ", "bảo hành", "đơn hàng",
      "giá", "tồn kho", "mua", "học đàn", "phụ kiện", "gewon",
      "chanhngot", "keyboard", "violin", "capo", "amply"
    ];

    if (!musicWords.some(word => q.includes(word))) {
      return "Xin lỗi bạn nhé 🍋 Mình chỉ hỗ trợ các câu hỏi về âm nhạc, nhạc cụ và sản phẩm tại Gewon Music. Bạn muốn tìm hiểu loại nhạc cụ nào?";
    }

    if (q.includes("đơn hàng") || q.includes("mã đơn")) {
      return "Bạn vui lòng kiểm tra mã đơn hàng và liên hệ kênh chăm sóc khách hàng chính thức của Gewon Music để xác minh. Chatbot này chưa được kết nối hệ thống đơn hàng.";
    }

    if (q.includes("tồn kho") || q.includes("còn hàng") ||
        q.includes("giá") || q.includes("bao nhiêu tiền")) {
      return "Mình chưa có dữ liệu giá và tồn kho trực tiếp nên chưa thể xác nhận chính xác. Bạn cho mình tên hoặc mã sản phẩm để tiện tra cứu với nhân viên Gewon Music nhé.";
    }

    if (q.includes("bảo hành")) {
      return "Chính sách bảo hành có thể khác nhau tùy sản phẩm. Bạn hãy cung cấp tên hoặc mã nhạc cụ để Gewon Music kiểm tra chính sách áp dụng nhé.";
    }

    if (q.includes("piano")) {
      return "🎹 Piano điện phù hợp nếu bạn cần gọn nhẹ, điều chỉnh âm lượng và dùng tai nghe. Piano cơ phù hợp nếu bạn ưu tiên cảm giác phím và âm thanh truyền thống. Bạn mua để học hay biểu diễn?";
    }

    if (q.includes("guitar")) {
      return "🎸 Guitar acoustic thường phù hợp đệm hát; guitar classic có dây nylon, cảm giác mềm hơn; guitar điện thường cần ampli hoặc thiết bị âm thanh. Bạn mới học hay đã chơi rồi?";
    }

    if (q.includes("organ") || q.includes("keyboard")) {
      return "🎹 Organ/keyboard phù hợp học nhạc, chơi giai điệu và đệm với nhiều âm sắc. Bạn mua cho trẻ em, người mới học hay biểu diễn?";
    }

    if (q.includes("ukulele")) {
      return "🎵 Ukulele nhỏ gọn, dễ mang theo và phù hợp người mới bắt đầu. Bạn muốn loại cho trẻ em hay người lớn?";
    }

    if (q.includes("trống")) {
      return "🥁 Trống điện thường tiện điều chỉnh âm lượng và luyện tập trong nhà; trống cơ cho cảm giác chơi tự nhiên hơn nhưng cần không gian. Bạn đang tìm trống điện hay trống cơ?";
    }

    if (q.includes("micro") || q.includes("loa") || q.includes("tai nghe") ||
        q.includes("phụ kiện") || q.includes("dây đàn") || q.includes("capo")) {
      return "🎧 Mình có thể giúp bạn chọn phụ kiện phù hợp. Bạn đang dùng nhạc cụ hoặc thiết bị nào? Hãy cho mình biết tên model nếu có nhé.";
    }

    if (q.includes("học đàn") || q.includes("mới học")) {
      return "🎶 Nếu mới học, bạn nên chọn nhạc cụ theo sở thích, ngân sách và thời gian luyện tập. Bạn thích piano, guitar, organ hay một nhạc cụ khác?";
    }

    return "🍋 Mình có thể tư vấn cách chọn và sử dụng nhạc cụ. Bạn cho mình biết thêm nhu cầu, trình độ và ngân sách dự kiến nhé.";
  }

  form.addEventListener("submit", event => {
    event.preventDefault();
    const question = input.value.trim();
    if (!question) return;
    addMessage(question, "cn-user");
    input.value = "";
    addMessage(reply(question), "cn-bot");
  });
})();
</script>
